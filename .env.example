# .env.example — Safe example environment configuration
# Copy this to .env and fill in your values.
# NEVER commit a .env file that contains real secrets to Git.

# ── Application ───────────────────────────────────────────────────────────────
# Path where the SQLite database file is stored.
# When using Docker Compose the default /data/tasks.db (inside the container)
# is used automatically via the docker-compose.yml environment section.
DATABASE_PATH=./data/tasks.db

# Enable CORS (only needed if frontend and backend run on separate origins)
ENABLE_CORS=false

# ── Docker Compose ────────────────────────────────────────────────────────────
# Port on the host machine that maps to the container's port 5000.
HOST_PORT=5000
