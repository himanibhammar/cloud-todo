# ═══════════════════════════════════════════════════════════════════════════
# .gitignore — Cloud To-Do Project
# ═══════════════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/

# ── Database files (never commit real task data) ──────────────────────────────
*.db
*.sqlite
*.sqlite3
data/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
*.env
!.env.example

# ── SSH private keys ──────────────────────────────────────────────────────────
*.pem
*.ppk
id_rsa
id_ed25519
*.key

# ── Terraform ─────────────────────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.d/
terraform/tfplan
terraform/*.tfplan
terraform/*.tfvars
!terraform/terraform.tfvars.example

# ── Ansible ───────────────────────────────────────────────────────────────────
ansible/inventory.ini
ansible/*.retry
ansible/.vault_pass

# ── Docker ────────────────────────────────────────────────────────────────────
*.tar.gz
cloud-todo-image.tar.gz

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Jenkins workspace artefacts ───────────────────────────────────────────────
workspace/
